<?xml version="1.0"?>
<sdf version="1.10">
  <model name="target_uav">
    <pose>0 0 7 0 0 0</pose>
    <link name="target_link">
      <inertial><mass>1.0</mass><inertia><ixx>0.03</ixx><iyy>0.03</iyy><izz>0.05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <gravity>false</gravity>
      <collision name="body_collision"><geometry><box><size>0.30 0.18 0.08</size></box></geometry></collision>
      <!-- Deterministic rendered-SIL detector stimulus only. It exercises the
           pixel detector path but is not detector-accuracy or target-size evidence. -->
      <visual name="single_target_detector_stimulus">
        <pose>0 0 -0.025 0 0 0</pose>
        <geometry><sphere><radius>0.26</radius></sphere></geometry>
        <material><diffuse>0.01 0.01 0.01 1</diffuse><specular>0 0 0 1</specular></material>
      </visual>
    </link>
    <plugin filename="libPngBetaflightSilBridge.so" name="png::sitl::DeterministicTargetMotion">
      <eastAmplitudeM>1.2</eastAmplitudeM>
      <northAmplitudeM>0.6</northAmplitudeM>
      <periodS>8</periodS>
      <verticalApproachStartS>7.5</verticalApproachStartS>
      <verticalApproachSpeedMps>5.0</verticalApproachSpeedMps>
      <maximumVerticalApproachM>5.6</maximumVerticalApproachM>
      <horizontalApproachDecayS>1.5</horizontalApproachDecayS>
      <cameraAlignmentStartS>5.8</cameraAlignmentStartS>
      <cameraAlignmentBlendS>0.5</cameraAlignmentBlendS>
      <interceptorModelName>interceptor</interceptorModelName>
      <cameraOffsetBodyFluM>0.06</cameraOffsetBodyFluM>
      <interceptorInitialHeightM>0.16</interceptorInitialHeightM>
    </plugin>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_model_pose>true</publish_model_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <update_frequency>50</update_frequency>
      <use_pose_vector_msg>true</use_pose_vector_msg>
    </plugin>
  </model>
</sdf>
