<?xml version="1.0"?>
<sdf version="1.10">
  <model name="interceptor">
    <pose>0 0 0.16 0 0 1.57079632679</pose>
    <self_collide>false</self_collide>
    <link name="base_link">
      <inertial>
        <mass>2.372</mass>
        <inertia>
          <ixx>0.070</ixx><iyy>0.070</iyy><izz>0.120</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="body_collision">
        <geometry><box><size>0.24 0.18 0.08</size></box></geometry>
      </collision>
      <visual name="body_visual">
        <geometry><box><size>0.24 0.18 0.08</size></box></geometry>
        <material><ambient>0.05 0.05 0.06 1</ambient><diffuse>0.12 0.12 0.14 1</diffuse></material>
      </visual>
      <visual name="arm_ne_sw">
        <pose>0 0 0 0 0 0.785398</pose>
        <geometry><box><size>0.62 0.025 0.018</size></box></geometry>
        <material><ambient>0.15 0.15 0.16 1</ambient><diffuse>0.25 0.25 0.26 1</diffuse></material>
      </visual>
      <visual name="arm_nw_se">
        <pose>0 0 0 0 0 -0.785398</pose>
        <geometry><box><size>0.62 0.025 0.018</size></box></geometry>
        <material><ambient>0.15 0.15 0.16 1</ambient><diffuse>0.25 0.25 0.26 1</diffuse></material>
      </visual>
      <sensor name="upward_camera" type="camera">
        <pose>0 0 0.06 0 -1.57079632679 0</pose>
        <topic>/world/png_betaflight_sitl/model/interceptor/link/base_link/sensor/upward_camera/image</topic>
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.08213</horizontal_fov>
          <image><width>640</width><height>512</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>100</far></clip>
        </camera>
        <always_on>true</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>

    <link name="motor_front_right"><pose relative_to="base_link">0.22 -0.22 0.01 0 0 0</pose><inertial><mass>0.01</mass><inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00004</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><visual name="rotor"><geometry><cylinder><radius>0.127</radius><length>0.004</length></cylinder></geometry><material><ambient>0.1 0.7 0.2 0.45</ambient><diffuse>0.1 0.7 0.2 0.45</diffuse></material></visual></link>
    <link name="motor_rear_left"><pose relative_to="base_link">-0.22 0.22 0.01 0 0 0</pose><inertial><mass>0.01</mass><inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00004</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><visual name="rotor"><geometry><cylinder><radius>0.127</radius><length>0.004</length></cylinder></geometry><material><ambient>0.1 0.7 0.2 0.45</ambient><diffuse>0.1 0.7 0.2 0.45</diffuse></material></visual></link>
    <link name="motor_front_left"><pose relative_to="base_link">0.22 0.22 0.01 0 0 0</pose><inertial><mass>0.01</mass><inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00004</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><visual name="rotor"><geometry><cylinder><radius>0.127</radius><length>0.004</length></cylinder></geometry><material><ambient>0.8 0.2 0.1 0.45</ambient><diffuse>0.8 0.2 0.1 0.45</diffuse></material></visual></link>
    <link name="motor_rear_right"><pose relative_to="base_link">-0.22 -0.22 0.01 0 0 0</pose><inertial><mass>0.01</mass><inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00004</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><visual name="rotor"><geometry><cylinder><radius>0.127</radius><length>0.004</length></cylinder></geometry><material><ambient>0.8 0.2 0.1 0.45</ambient><diffuse>0.8 0.2 0.1 0.45</diffuse></material></visual></link>

    <joint name="motor_front_right_joint" type="revolute"><parent>base_link</parent><child>motor_front_right</child><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
    <joint name="motor_rear_left_joint" type="revolute"><parent>base_link</parent><child>motor_rear_left</child><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
    <joint name="motor_front_left_joint" type="revolute"><parent>base_link</parent><child>motor_front_left</child><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
    <joint name="motor_rear_right_joint" type="revolute"><parent>base_link</parent><child>motor_rear_right</child><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>

    <!-- Official SITL publishes normalized motors as M2,M3,M4,M1. -->
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel"><robotNamespace>interceptor</robotNamespace><jointName>motor_front_right_joint</jointName><linkName>motor_front_right</linkName><turningDirection>cw</turningDirection><timeConstantUp>0.025</timeConstantUp><timeConstantDown>0.04</timeConstantDown><maxRotVelocity>2200</maxRotVelocity><motorConstant>1.62e-05</motorConstant><momentConstant>0.016</momentConstant><commandSubTopic>command/motor_speed</commandSubTopic><actuator_number>0</actuator_number><rotorDragCoefficient>8.0e-05</rotorDragCoefficient><rollingMomentCoefficient>1e-06</rollingMomentCoefficient><motorSpeedPubTopic>motor_speed/0</motorSpeedPubTopic><rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType></plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel"><robotNamespace>interceptor</robotNamespace><jointName>motor_rear_left_joint</jointName><linkName>motor_rear_left</linkName><turningDirection>cw</turningDirection><timeConstantUp>0.025</timeConstantUp><timeConstantDown>0.04</timeConstantDown><maxRotVelocity>2200</maxRotVelocity><motorConstant>1.62e-05</motorConstant><momentConstant>0.016</momentConstant><commandSubTopic>command/motor_speed</commandSubTopic><actuator_number>1</actuator_number><rotorDragCoefficient>8.0e-05</rotorDragCoefficient><rollingMomentCoefficient>1e-06</rollingMomentCoefficient><motorSpeedPubTopic>motor_speed/1</motorSpeedPubTopic><rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType></plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel"><robotNamespace>interceptor</robotNamespace><jointName>motor_front_left_joint</jointName><linkName>motor_front_left</linkName><turningDirection>ccw</turningDirection><timeConstantUp>0.025</timeConstantUp><timeConstantDown>0.04</timeConstantDown><maxRotVelocity>2200</maxRotVelocity><motorConstant>1.62e-05</motorConstant><momentConstant>0.016</momentConstant><commandSubTopic>command/motor_speed</commandSubTopic><actuator_number>2</actuator_number><rotorDragCoefficient>8.0e-05</rotorDragCoefficient><rollingMomentCoefficient>1e-06</rollingMomentCoefficient><motorSpeedPubTopic>motor_speed/2</motorSpeedPubTopic><rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType></plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel"><robotNamespace>interceptor</robotNamespace><jointName>motor_rear_right_joint</jointName><linkName>motor_rear_right</linkName><turningDirection>ccw</turningDirection><timeConstantUp>0.025</timeConstantUp><timeConstantDown>0.04</timeConstantDown><maxRotVelocity>2200</maxRotVelocity><motorConstant>1.62e-05</motorConstant><momentConstant>0.016</momentConstant><commandSubTopic>command/motor_speed</commandSubTopic><actuator_number>3</actuator_number><rotorDragCoefficient>8.0e-05</rotorDragCoefficient><rollingMomentCoefficient>1e-06</rollingMomentCoefficient><motorSpeedPubTopic>motor_speed/3</motorSpeedPubTopic><rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType></plugin>

    <plugin filename="libPngBetaflightSilBridge.so" name="png::sitl::BetaflightSilBridge">
      <motorCommandTopic>/interceptor/command/motor_speed</motorCommandTopic>
      <maxRotVelocity>2200</maxRotVelocity>
      <originLatitudeDeg>22.7991667</originLatitudeDeg>
      <originLongitudeDeg>113.86</originLongitudeDeg>
      <originAltitudeM>20</originAltitudeM>
    </plugin>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_model_pose>true</publish_model_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <update_frequency>50</update_frequency>
      <use_pose_vector_msg>true</use_pose_vector_msg>
    </plugin>
  </model>
</sdf>
